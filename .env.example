# ── Database ───────────────────────────────────────────────
# This build runs on PostgreSQL through Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Supabase (used when you apply supabase/migrations on a Supabase project) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to the browser

# ── Payments (Razorpay) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # webhook URL: {APP_URL}/api/payments/webhook (events: payment.captured, order.paid, payment.failed)

# ── Notifications ──────────────────────────────────────────
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_TOKEN=
EMAIL_PROVIDER_API_KEY=

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used in QR verification links
ADMIN_SETUP_TOKEN=                # optional: required on the one-time /setup page
CRON_SECRET=                      # protects GET /api/notifications/cron (renewal reminders)
UPLOAD_DIR=                       # optional: persistent folder for uploaded files (default .data/uploads)
